---
import MyPicture from "@/components/MyPicture.astro";
import { numberToPrice } from "@/utils/numberToPrice";
import type { CollectionEntry } from "astro:content";

interface Props {
  course: CollectionEntry<"courses">;
  couponCode?: string;
  prices?: { old: number; new: number };
}

const { course, couponCode, prices } = Astro.props,
  { pricingPlanId } = course.data,
  sixMonthsAgo = new Date();
sixMonthsAgo.setMonth(sixMonthsAgo.getMonth() - 6);

const isUpdated = course.data.updatedDate
    ? new Date(course.data.updatedDate) >= sixMonthsAgo
    : false,
  isNew = course.data.publishedDate
    ? new Date(course.data.publishedDate) >= sixMonthsAgo
    : false,
  badge = course.data.isFree
    ? "Free"
    : isUpdated
      ? "Updated"
      : isNew
        ? "New"
        : undefined,
  courseURL = `/courses/${course.id}`,
  checkoutURL = `https://courses.rockthejvm.com/purchase?product_id=${pricingPlanId}${couponCode ? `&coupon=${couponCode}` : ""}`;
---

<div
  class="flex h-full w-full max-w-sm flex-col overflow-hidden rounded-xl bg-holiday-content/5 ring-1 ring-holiday-content/25 transition-shadow hover:ring-holiday-content/50"
>
  <a href={courseURL} class="relative block hover:no-underline">
    <div class="max-h-52 w-full overflow-hidden">
      <MyPicture
        src={course.data.heroImage}
        alt={course.data.title}
        quality="mid"
        class="min-h-full min-w-full object-cover object-center"
        widths={[400, 768]}
        sizes="(min-width: 640px) 384px, 100vw"
      />
    </div>
    {
      badge && (
        <span class="absolute right-3 top-3 rounded-full bg-holiday-cta px-2.5 py-0.5 text-xs font-semibold text-holiday-ctatext shadow-sm">
          {badge}!
        </span>
      )
    }
  </a>
  <div class="flex flex-1 flex-col p-5">
    <a href={courseURL} class="hover:no-underline">
      <h3
        class="text-xl font-semibold leading-6 text-holiday-content hover:text-holiday-accent-1 md:text-2xl"
      >
        {course.data.title}
      </h3>
    </a>
    <div class="mt-3 flex-1 text-sm text-holiday-content-2">
      <Fragment set:html={course.data.excerpt} />
    </div>
    {
      prices && prices.old > 0 && (
        <div class="mt-4 flex items-baseline gap-x-3">
          <span class="text-2xl font-bold text-holiday-accent-1">
            ${numberToPrice(prices.new)}
          </span>
          <s class="text-holiday-content-2">${numberToPrice(prices.old)}</s>
        </div>
      )
    }
    <div class="mt-5 flex gap-x-3">
      <a
        href={checkoutURL}
        class="flex-1 rounded-md bg-holiday-cta px-4 py-2.5 text-center text-sm font-semibold text-holiday-ctatext shadow-sm transition-colors hover:bg-holiday-accent-1 hover:text-white hover:no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-holiday-accent-1"
      >
        {course.data.isFree ? "Get it free" : "1-click buy"}
      </a>
      <a
        href={courseURL}
        class="flex-1 rounded-md px-4 py-2.5 text-center text-sm font-semibold text-holiday-content ring-1 ring-inset ring-holiday-content/30 transition-colors hover:text-holiday-content hover:no-underline hover:ring-holiday-content/60"
      >
        Learn more
      </a>
    </div>
  </div>
</div>
