---
import RockTheJVM from "@/components/icons/RockTheJVM.astro";

interface Props {
  annotation: string;
  logoSuffix: string;
  subtitle1: string;
  subtitle2: string;
  title: string;
}

const { annotation, logoSuffix, subtitle1, subtitle2, title } = Astro.props;
---

<header class="relative isolate overflow-hidden pb-16 pt-12 md:pt-20">
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_left,_rgba(249,115,22,0.16),_transparent_55%),radial-gradient(ellipse_at_bottom_right,_rgba(56,189,248,0.08),_transparent_55%)]"
  >
  </div>

  <div
    class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-x-12 gap-y-10 px-4 sm:px-6 lg:grid-cols-2 lg:px-8"
  >
    <div class="flex flex-col items-start">
      <div
        class="mb-6 rounded-full px-3 py-1 text-sm leading-6 text-holiday-content-1 ring-1 ring-holiday-content/10"
      >
        {annotation}
      </div>
      <h1
        class="text-4xl font-extrabold tracking-tight text-holiday-content sm:text-5xl lg:text-6xl"
      >
        {`${title} ${new Date().getFullYear()}`}
      </h1>
      <p class="mt-4 text-lg leading-8 text-holiday-content-2 sm:mt-6">
        {subtitle1}
      </p>
      <p
        class="mt-2 text-lg font-semibold leading-8 text-holiday-accent-1 sm:mt-3"
      >
        {subtitle2}
      </p>
      <div class="mt-6 flex flex-col gap-y-3 sm:mt-8 sm:flex-row sm:gap-x-4">
        <a
          href="#bundle"
          class="rounded-md bg-holiday-cta px-5 py-3 text-center text-sm font-semibold text-holiday-ctatext shadow-sm transition-colors hover:bg-holiday-accent-1 hover:text-white hover:no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-holiday-accent-1"
        >
          See the bundle
        </a>
        <a
          href="#courses"
          class="rounded-md px-5 py-3 text-center text-sm font-semibold text-holiday-content ring-1 ring-inset ring-holiday-content/30 transition-colors hover:text-holiday-content hover:no-underline hover:ring-holiday-content/60"
        >
          Browse the sale &darr;
        </a>
      </div>
    </div>

    <div class="flex justify-center lg:justify-end">
      <RockTheJVM class="h-40 w-full sm:h-56 lg:h-64" suffix={logoSuffix} />
    </div>
  </div>
</header>
