---
import type { HolidayCategory } from "../_types/holidayCategory.ts";
import HolidayCourseCard from "./HolidayCourseCard.astro";

interface Props {
  categories: HolidayCategory[];
  couponCode: string;
}

const { categories, couponCode } = Astro.props;
---

<article id="courses" class="scroll-mt-20 pb-12 md:pb-20">
  {
    categories.map(({ category, description, courses }) => (
      <section class="pt-8 md:pt-12">
        <div class="mx-auto max-w-3xl px-8 text-center">
          <h2 class="font-bold text-holiday-content">{category}</h2>
          <p class="mt-2 text-holiday-content-2">{description}</p>
        </div>
        <ul class="mx-auto my-8 grid max-w-7xl list-none grid-cols-1 gap-6 px-8 sm:grid-cols-2 lg:grid-cols-3">
          {courses.map(({ course, hasCoupon, prices }) => (
            <li class="col-span-1 flex justify-center">
              <HolidayCourseCard
                {course}
                couponCode={hasCoupon ? couponCode : undefined}
                {prices}
              />
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</article>
